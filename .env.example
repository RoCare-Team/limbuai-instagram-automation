# Copy this file to .env and fill in your real values

# Get this from Graph API Explorer / Instagram Business Login setup
IG_ACCESS_TOKEN=paste_your_long_lived_access_token_here

# Your Instagram Business Account ID (from me?fields=id,username)
IG_USER_ID=27113964721610560

# Any random string you choose — must match what you enter in Meta's Webhook setup
VERIFY_TOKEN=limbuai_verify_123

# Optional — from App Settings > Basic > App Secret. Used to verify webhook signatures.
APP_SECRET=
