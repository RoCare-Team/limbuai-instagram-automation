# Copy this file to .env and fill in your real values

# --- Instagram app credentials (required for the login button) ---
# Meta App Dashboard -> Instagram -> API setup with Instagram business login
IG_APP_ID=your_instagram_app_id
IG_APP_SECRET=your_instagram_app_secret

# Must match exactly one of the "OAuth redirect URIs" in the App Dashboard
IG_REDIRECT_URI=http://localhost:8000/auth/callback

# Public URL of this deployment. Needed so Instagram can download images you
# publish, and to build the redirect URI when deployed.
PUBLIC_BASE_URL=

# --- Optional manual token (skips the login flow, handy for local testing) ---
IG_ACCESS_TOKEN=
IG_USER_ID=

# Any random string you choose - must match what you enter in Meta's Webhook setup
VERIFY_TOKEN=limbuai_verify_123

# From App Settings > Basic > App Secret. Used to verify webhook signatures.
APP_SECRET=
